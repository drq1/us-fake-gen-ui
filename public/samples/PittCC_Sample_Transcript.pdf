(function() {
  'use strict';

  // Function to process links with href="#"
  function processHashLinks() {
    const menuIds = ['menu-main-menu-right', 'menu-main-menu-left', 'menu-new-mobile-menu'];
    
    menuIds.forEach(menuId => {
      const menuContainer = document.getElementById(menuId);
      if (!menuContainer) return;
      
      const hashLinks = menuContainer.querySelectorAll('a[href="#"]');
      hashLinks.forEach(link => {
        link.setAttribute('role', 'button');
      });
    });
  }

  // Set up mutation observer to watch for dynamically added content
  function setupMutationObserver() {
    const observer = new MutationObserver(mutations => {
      let shouldProcess = false;
      
      mutations.forEach(mutation => {
        // Check if nodes were added
        if (mutation.addedNodes.length > 0) {
          mutation.addedNodes.forEach(node => {
            // Check if it's an element node
            if (node.nodeType === 1) {
              // Check if it's one of our menu containers or contains them
              if (node.id === 'menu-main-menu-right' || 
                  node.id === 'menu-main-menu-left' ||
                  node.id === 'menu-new-mobile-menu' ||
                  node.querySelector('#menu-main-menu-right, #menu-main-menu-left, #menu-new-mobile-menu') ||
                  // Check if it's an anchor within our menus
                  (node.tagName === 'A' && node.closest('#menu-main-menu-right, #menu-main-menu-left, #menu-new-mobile-menu'))) {
                shouldProcess = true;
              }
            }
          });
        }
        
        // Check if attributes changed on anchors in our menus
        if (mutation.type === 'attributes' && 
            mutation.target.tagName === 'A' &&
            mutation.target.closest('#menu-main-menu-right, #menu-main-menu-left, #menu-new-mobile-menu')) {
          shouldProcess = true;
        }
      });
      
      if (shouldProcess) {
        processHashLinks();
      }
    });

    // Start observing the document body for changes
    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['href']
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      processHashLinks();
      setupMutationObserver();
    });
  } else {
    // DOM already loaded
    processHashLinks();
    setupMutationObserver();
  }
})();
</script>
<script>
// Function to disable links
function disableRedundantLinks() {
  const links = document.querySelectorAll('.em-item-image-placeholder');
  
  links.forEach(link => {
    // Skip if already processed
    if (link.hasAttribute('data-link-disabled')) return;
    
    // Remove link semantics and functionality
    link.removeAttribute('href');
    link.setAttribute('tabindex', '-1');
    link.setAttribute('aria-hidden', 'true');
    link.setAttribute('role', 'presentation');
    link.style.pointerEvents = 'none';
    link.style.cursor = 'default';
    
    // Mark as processed
    link.setAttribute('data-link-disabled', 'true');
  });
}

// Run on DOM load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', disableRedundantLinks);
} else {
  // DOM already loaded
  disableRedundantLinks();
}

// Set up mutation observer for dynamically added content
const observer = new MutationObserver((mutations) => {
  mutations.forEach((mutation) => {
    mutation.addedNodes.forEach((node) => {
      // Check if the added node itself is a target link
      if (node.nodeType === 1 && node.classList?.contains('em-item-image-placeholder')) {
        disableRedundantLinks();
      }
      // Check if any descendants are target links
      else if (node.nodeType === 1 && node.querySelectorAll) {
        const links = node.querySelectorAll('.em-item-image-placeholder');
        if (links.length > 0) {
          disableRedundantLinks();
        }
      }
    });
  });
});

// Start observing
observer.observe(document.body, {
  childList: true,
  subtree: true
});
</script>
<script>
// Wait for DOM to be fully loaded
document.addEventListener('DOMContentLoaded', function() {
  
  // Function to add title to iframe
  function addTitleToIframe() {
    const iframe = document.querySelector('.libraryh3lp > iframe');
    if (iframe && !iframe.hasAttribute('title')) {
      iframe.setAttribute('title', 'Chat With a Librarian');
      console.log('Title added to libraryh3lp iframe');
      return true;
    }
    return false;
  }
  
  // Try to add title immediately in case iframe already exists
  if (addTitleToIframe()) {
    return; // Exit if iframe was found and title was added
  }
  
  // Create a MutationObserver to watch for the iframe being added
  const observer = new MutationObserver(function(mutations) {
    if (addTitleToIframe()) {
      observer.disconnect(); // Stop observing once title is added
    }
  });
  
  // Start observing the document body for changes
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
});
</script>
