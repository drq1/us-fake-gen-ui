<style id="wp-custom-css">
div.thumbnail {
	max-width: 100%;
}

body.home .slick-slide {
/* 	height: 0px; */
}

body.home .slick-active {
/* 	width: 100% !important; */
/* 	width: 100vw !important; */
}

div.academic-hero {
/* 	background-position: 50% calc(50% + 130px); */
/*background-position: 50% 25%;*/
}

body.home .top-bar {
	background-color: rgba(13,58,143, 0.8);
}

body.home > div.container-fluid {
	position: relative;
}

.navbar-right .dropdown-menu, .navbar-left .dropdown-menu {
    right: auto;
    left: 0;
    background-color: #063ea9;
}

h2 {
    color: #0055b8;
    font-family: "Open Sans", arial, sans-serif;
    font-size: 1.8em;
}

.ui-datepicker-title select {
	background:#333;
}

.links ul li a {
	border-bottom: none;
}

.posts-list article {
	/*z-index: 99;*/
}

.white a.elementor-button {
	border-color: #fff;
}

.white .elementor-button .elementor-button-text {
	color: #fff;
}

ul.nav-tabs > li > a {
    font-family: "Montserrat", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    background-color: #002e64;
    padding: 8px 15px;
    letter-spacing: -1px;
	  margin-top: 5px;
}

body.page-id-852 div.individual.departments-directory {
	margin-bottom: 15px;
}

body.page-id-852 span.fn.n.notranslate {
    text-transform: none;
    font-weight: normal;
}

.cn-alphaindex {
	float: left;
}

table.departmentDirectory td {
	border: 1px solid #000;
}

table td {
	padding: 8px;
}

.directoryLinks {
	margin-right: 15px;
}

#tablepress-9 th {
    text-align: center;
}

#menu-new-mobile-menu li {
    float: left;
    background-color: transparent;
  }
  #menu-new-mobile-menu li > a {
    /* Regular menu item style */
    display: block;
    padding: 0 10px;
    background: transparent;
    font-size: 14px;
    line-height: 50px;
    color: #ffffff;
    font-family: "Open Sans", sans-serif;
    font-weight: 700;
  }
  #menu-new-mobile-menu li.current-menu-item > a, #menu-new-mobile-menu li.current_page_ancestor > a, #menu-new-mobile-menu li.current_page_parent > a {
    /* Style of Current page and Ancestor page */
    background: #141230;
    color: #ffffff;
  }
  #menu-new-mobile-menu li.has-dropdown > a {
    /* Style of item with dropdown */
    padding: 0 15px;
  }
  #menu-new-mobile-menu li.has-dropdown > a:after {
    /* Hide dropdown arrow */
    display: none !important;
  }
  #menu-new-mobile-menu li.has-dropdown > a:hover {
    /* Hover state for dropdown link */
  }
  #menu-new-mobile-menu li > a:hover, #menu-new-mobile-menu li > a:focus {
    /* menu item style on hover */
    background: #141230;
    color: #ffffff;
  }
  #menu-new-mobile-menu:after {
    content: '';
    display: table;
    clear: both;
  }

@media only screen and (max-width: 991px) {
}

@media only screen and (max-width: 767px) {
	#menu-new-mobile-menu > li, #menu-new-mobile-menu > li > ul > li {
		width: 100%;
	}
	
	#menu-new-mobile-menu > li > ul > li {
		margin-left: 15px;
	}

	body.home nav.top-bar {
		background-color: #063ea9 !important;
	}
}

body.page-id-455 h5 a {
	font-size: 15.9px;
	font-weight: 600;
	font-family: "Open Sans", sans-serif;
}

body.page-id-455 ul, body.page-id-455 p {
	margin-bottom: 0px !important;
}

aside.download-widget.widget p {
	text-align: center;
}

form p {
	font-size: 16px;
}

body.page-id-852 .main-content-before-after.rel {
	padding: 142px 0 0px;
}

.department-directory-filters {
	margin-top: 38px;
	padding-bottom: 40px;
}

@media only screen and (max-width: 767px) {
	.header-text {
    display: block;
    text-align: center;
		max-height: 28px;
	}
}

.top-bar #menu-main-menu-left li > a:focus, .top-bar #menu-main-menu-right li > a:focus {
    background: #141230;
    color: #ffffff;
}

.home-classes-one:focus {
    box-shadow: inset 0 0 0 25px #0055B8;
}

.home .mnews a:focus {
    text-decoration: underline;
}

#cn-page-nav .page-numbers.current, #cn-page-nav .page-numbers.dots, #cn-page-nav a.disabled, #cn-page-nav a:active, #cn-page-nav a:visited, #cn-page-nav .page-numbers, #cn-page-nav a {
	color: #063ea9 !important;
}

.academic-top-content h4 {
	color: rgb(45, 50, 60);
}

.pagination>li>a, .pagination>li>span {
	color: #19558c;
}

.s-lib-color-lt-grey {
	color: #555;
}

.searchsubmit {
	background-color: #46464b;
	color: #e1e1e1;
}

.program-content a, .academic-content a {
	font-weight: 600;
}

.skipNav a {
	position: absolute;
	left: -250px;
	color: #fff;
	z-index: 999
		
}

.skipNav a:focus {
	left: 10px;
	top: 50px;
	outline: 5px auto -webkit-focus-ring-color;
	outline-offset: 2px;
}

*:focus, .dropdown-toggle:focus {
	outline: 5px auto -webkit-focus-ring-color;
	outline-offset: 2px;
}

a:focus div.logo-container img {
	outline: 5px auto -webkit-focus-ring-color;
	outline-offset: 2px;
}


div.right-menu ul.dropdown-menu li, div.left-menu ul.dropdown-menu li {
	list-style-type: none;
}

.home .footer-calendar-multiday > .mday > i {
	color: #8baede;
}

a.button.btn:focus {
	/*color: #fff;*/
}

#cn-list span.fw700 {
	font-weight: 700;
}

.btn.focus, .btn:focus, .btn:hover {
	/*color: #000;*/
}


/* Add Transparency to Menu Bar */
.header .left-menu, .header .right-menu {
    background-color: #063ea900;
}

.header .left-menu:before, .header .right-menu:before {
    background-color: #063ea900;
}

.footer-calendar li {
  background-color: #143082;
}

#home-slider .slick-slide {
    height: 65vh;
}

.home-classes-one {
    height: 24vh;
  	/*box-shadow: inset 0 0 0px 500px #00000026;*/
    box-shadow: inset 0 0 0px 500px #00000036;	
}

.home-classes h4 {
    padding: 1vh;
}

#home-slider .slider-caption {
    bottom: 1vh;
    width: unset;
    max-width: 57%;
    background: rgb(68 176 43 / 73%);
    padding: 20px;
		border-radius: 10px;
}

.home-classes h4 {
    border-bottom: unset;
}

.nav-tabs>li.active>a, .nav-tabs>li.active>a:focus, .nav-tabs>li.active>a:hover {
    border: 1px solid #0250AE;
}

.links .c-links {
    margin-bottom: 3em;
    columns: 2;
    -webkit-columns: 2;
    -moz-columns: 2;
}

.links ul li {
    display: inline-block;
    width: 100%;
    margin: 3px 0 4px;
    vertical-align: top;
}

#home-slider .slider-caption:hover {
	background: rgb(68 176 43 / 100%);
    scale: 1.04;
    box-shadow: 0px 5px 15px 0px #0000002b;
}

.gform_wrapper li.gfield[class*=col][class*=gf_list_] ul.gfield_checkbox li, .gform_wrapper li.gfield[class*=col][class*=gf_list_] ul.gfield_radio li {
	font-size: 1.5rem;
}

hr {
	border-top: 1px solid #c8c8c8;
}

div.staff-member {
	cursor: pointer;
}

h3.staff-member-name {
	border-bottom: 1px solid #00508d;
	position: relative;
}


h3.staff-member-name:after {
	content: '';
	display: inline-block;
	background-color: #00508d;
	background-image: url('https://pittcc.edu/wp-content/plugins/connections-slim-plus/sprite.gif');
	background-size: cover;
	background-repeat: no-repeat;
	width: 20px;
	height: 20px !important;
	position: absolute;
	right: 0px;
	bottom: 0px;
}

h3.staff-member-name a {
	font-size: 16px;
	text-transform: uppercase;
	text-decoration: none !important;
}

div.staff-member-right p, div.staff-member-right div {
	display: none;
}

div.staff-member-right.active p, div.staff-member-right.active div {
	display: block;
	margin-bottom: 0px;
}

div.staff-member {
	min-height: 0px;
	margin-bottom: 10px;
}

header.header form.searchform input[type="search"] {
	color: #fff;
}

.cta-button a.btn {
	background-color: #348721;
}

.gform_wrapper.gravity-theme .ginput_counter {
	color: #000;
}
</style>
</head>

